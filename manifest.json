{
  "manifest_version": 3,
  "name": "One Search To Rule Them All",
  "short_name": "One Search",
  "version": "1.1.14",
  "description": "Spotlight-Like Search that fixes New Tab + Search for all Chromium Browsers",
  "minimum_chrome_version": "127",
  "permissions": [
    "tabs",
    "storage",
    "favicon",
    "activeTab",
    "scripting",
    "search",
    "alarms",
    "contextMenus"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Search",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open a new tab"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_permissions": [
    "history",
    "bookmarks"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
